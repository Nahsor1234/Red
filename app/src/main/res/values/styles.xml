<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Platform theme: Compose draws all UI; this only styles the window behind it. -->
    <style name="AppTheme" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/cc_background</item>
        <item name="android:navigationBarColor">@color/cc_background</item>
        <item name="android:statusBarColor">@color/cc_background</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:colorPrimary">@color/cc_primary</item>
        <item name="android:colorAccent">@color/cc_primary</item>
    </style>
</resources>
